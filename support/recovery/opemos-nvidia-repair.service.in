[Unit]
Description=OPEMOS delayed-network exact NVIDIA repair
After=network-online.target opemos-nvidia-guardian.service opemos-interstitial.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=@DEST@/bootstrap/run_repair_with_interstitial.sh
SuccessExitStatus=75
TimeoutStartSec=7200
