{
  "$id": "https://corniidog.github.io/OPEMOS/contracts/installer-initramfs-verification-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "kernelVersion": {
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._+~-]+$",
      "type": "string"
    },
    "proof": {
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "sizeBytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["path", "sizeBytes", "sha256"],
      "type": "object"
    },
    "modulePath": {
      "maxLength": 1024,
      "pattern": "^usr/lib/modules/[A-Za-z0-9._+~-]+/(?:[A-Za-z0-9._+~/-]+/)?nvidia(?:-modeset|-uvm|-drm)?\\.ko(?:\\.(?:gz|xz|zst|lz4|lzo))?$",
      "type": "string"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "configPath": {"const": "etc/modprobe.d/99-open-gpu-kernel-modules-steamos.conf"},
        "entries": {"maximum": 200000, "minimum": 1, "type": "integer"},
        "filename": {
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9@._+~:-]+$",
          "type": "string"
        },
        "listingSha256": {"$ref": "#/$defs/hash"},
        "modules": {
          "additionalProperties": false,
          "properties": {
            "nvidia-drm.ko": {"$ref": "#/$defs/modulePath"},
            "nvidia-modeset.ko": {"$ref": "#/$defs/modulePath"},
            "nvidia-uvm.ko": {"$ref": "#/$defs/modulePath"},
            "nvidia.ko": {"$ref": "#/$defs/modulePath"}
          },
          "required": ["nvidia.ko", "nvidia-modeset.ko", "nvidia-uvm.ko", "nvidia-drm.ko"],
          "type": "object"
        },
        "sha256": {"$ref": "#/$defs/hash"},
        "sizeBytes": {"maximum": 2147483648, "minimum": 1, "type": "integer"}
      },
      "required": ["filename", "sizeBytes", "sha256", "listingSha256", "entries", "modules", "configPath"],
      "type": "object"
    }
  },
  "description": "Successful initramfs proof emitted by verify_initramfs.py. The record is self-describing; the terminal installer validates its exact target-kernel binding.",
  "properties": {
    "config": {
      "allOf": [{"$ref": "#/$defs/proof"}],
      "properties": {
        "path": {"const": "/etc/modprobe.d/99-open-gpu-kernel-modules-steamos.conf"},
        "sizeBytes": {"maximum": 1048576}
      }
    },
    "images": {
      "items": {"$ref": "#/$defs/image"},
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "kernelVersion": {
      "allOf": [{"$ref": "#/$defs/kernelVersion"}, {"not": {"const": "unknown"}}]
    },
    "requiredModules": {
      "const": ["nvidia.ko", "nvidia-modeset.ko", "nvidia-uvm.ko", "nvidia-drm.ko"]
    },
    "rootfsOnlyModules": {"const": ["nvidia-peermem.ko"]},
    "schemaVersion": {"const": 1},
    "status": {"const": "verified"},
    "tools": {
      "additionalProperties": false,
      "properties": {
        "lsinitcpio": {
          "allOf": [{"$ref": "#/$defs/proof"}],
          "properties": {"path": {"const": "/usr/bin/lsinitcpio"}, "sizeBytes": {"maximum": 8388608}}
        },
        "mkinitcpio": {
          "allOf": [{"$ref": "#/$defs/proof"}],
          "properties": {"path": {"const": "/usr/bin/mkinitcpio"}, "sizeBytes": {"maximum": 8388608}}
        }
      },
      "required": ["mkinitcpio", "lsinitcpio"],
      "type": "object"
    }
  },
  "required": ["schemaVersion", "status", "kernelVersion", "requiredModules", "rootfsOnlyModules", "tools", "config", "images"],
  "title": "OPEMOS installer initramfs verification v1",
  "type": "object",
  "unevaluatedProperties": true
}
