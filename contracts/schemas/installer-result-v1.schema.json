{
  "$id": "https://corniidog.github.io/OPEMOS/contracts/installer-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cleanup": {
      "properties": {
        "compressionPolicyRestored": {"type": "boolean"},
        "mountsReleased": {"type": "boolean"},
        "runtimeMountsExpected": {"maximum": 64, "minimum": 0, "type": "integer"},
        "runtimeMountsReleased": {"maximum": 64, "minimum": 0, "type": "integer"}
      },
      "required": [
        "mountsReleased",
        "runtimeMountsExpected",
        "runtimeMountsReleased",
        "compressionPolicyRestored"
      ],
      "type": "object"
    },
    "filename": {
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9@._+~:-]+$",
      "type": "string"
    },
    "kernelVersion": {
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._+~-]+$",
      "type": "string"
    },
    "target": {
      "properties": {
        "architecture": {"const": "x86_64"},
        "kernelVersion": {"$ref": "#/$defs/kernelVersion"},
        "nvidiaVersion": {"$ref": "#/$defs/version"},
        "root": {"const": "/target-root"},
        "steamosVersion": {"$ref": "#/$defs/version"}
      },
      "required": ["root", "steamosVersion", "kernelVersion", "nvidiaVersion", "architecture"],
      "type": "object"
    },
    "version": {
      "maxLength": 64,
      "pattern": "^(?:unknown|[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$",
      "type": "string"
    },
    "workspace": {
      "properties": {
        "condition": {"const": "available"},
        "mode": {"const": "1777"},
        "phase": {"const": "mounted_workspace"},
        "reason": {"const": "initramfs_workspace_available"},
        "schemaVersion": {"const": 1},
        "status": {"const": "verified"}
      },
      "required": ["schemaVersion", "status", "reason", "phase", "condition", "mode"],
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}, "required": ["status"]},
      "then": {
        "properties": {
          "cleanup": {
            "properties": {
              "compressionPolicyRestored": {"const": true},
              "mountsReleased": {"const": true}
            }
          },
          "initramfsVerification": {"$ref": "installer-initramfs-verification-v1.schema.json"},
          "initramfsWorkspace": {"$ref": "#/$defs/workspace"},
          "moduleVerification": {"$ref": "installer-module-verification-v1.schema.json"},
          "payloadReceipt": {"$ref": "installer-payload-receipt-v1.schema.json"},
          "phase": {"const": "complete"},
          "reason": {"const": "install_complete"},
          "userspaceVerification": {"$ref": "installer-userspace-verification-v1.schema.json"},
          "validation": {"$ref": "installer-validation-v1.schema.json"}
        },
        "required": [
          "validation",
          "moduleVerification",
          "userspaceVerification",
          "initramfsWorkspace",
          "initramfsVerification",
          "payloadReceipt"
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "validated"}}, "required": ["status"]},
      "then": {
        "properties": {
          "phase": {"const": "validated"},
          "reason": {"const": "validation_complete"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}, "required": ["status"]},
      "then": {"properties": {"reason": {"const": "cancelled"}}}
    }
  ],
  "description": "Additive terminal result emitted by bootstrap/install_to_root.sh. Cross-record target, package, and payload-hash equality remains enforced by lib/validate_install_contract.py.",
  "properties": {
    "cleanup": {"$ref": "#/$defs/cleanup"},
    "initramfsVerification": {"$ref": "installer-initramfs-verification-v1.schema.json"},
    "initramfsWorkspace": {"type": "object"},
    "inputs": {
      "properties": {
        "archive": {"anyOf": [{"$ref": "#/$defs/filename"}, {"type": "null"}]},
        "lib32NvidiaUtils": {"anyOf": [{"$ref": "#/$defs/filename"}, {"type": "null"}]},
        "nvidiaUtils": {"anyOf": [{"$ref": "#/$defs/filename"}, {"type": "null"}]},
        "provenance": {"anyOf": [{"$ref": "#/$defs/filename"}, {"type": "null"}]}
      },
      "required": ["archive", "provenance", "nvidiaUtils", "lib32NvidiaUtils"],
      "type": "object"
    },
    "message": {"maxLength": 2048, "minLength": 1, "type": "string"},
    "moduleVerification": {"$ref": "installer-module-verification-v1.schema.json"},
    "payloadReceipt": {"$ref": "installer-payload-receipt-v1.schema.json"},
    "phase": {"maxLength": 64, "pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
    "reason": {"maxLength": 64, "pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
    "schemaVersion": {"const": 1},
    "status": {"enum": ["success", "failed", "cancelled", "validated"]},
    "target": {"$ref": "#/$defs/target"},
    "trust": {
      "enum": ["pending-validation", "development-unverified", "locally-built-verified", "certified-published"]
    },
    "userspaceVerification": {"$ref": "installer-userspace-verification-v1.schema.json"},
    "validation": {"$ref": "installer-validation-v1.schema.json"}
  },
  "required": ["schemaVersion", "status", "reason", "message", "phase", "trust", "target", "inputs", "cleanup"],
  "title": "OPEMOS offline installer result v1",
  "type": "object",
  "unevaluatedProperties": true
}
