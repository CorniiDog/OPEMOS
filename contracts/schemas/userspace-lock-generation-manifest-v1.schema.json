{
  "$id": "https://corniidog.github.io/OPEMOS/contracts/userspace-lock-generation-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "maxLength": 255,
          "pattern": "^(?!.*[.]$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|$))[A-Za-z0-9@._+~-]+$",
          "type": "string"
        },
        "role": {
          "enum": ["gaming-profile", "keyring", "package", "package-signature", "provenance", "signer-policy", "target-policy", "userspace-lock"]
        },
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "size": {"maximum": 2147483648, "minimum": 1, "type": "integer"}
      },
      "required": ["role", "filename", "size", "sha256"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Inactive closed schema-1 immutable manifest for reviewed userspace-lock data generations. Discovery equality, total allocation, target-lock membership, and replay/lineage checks are semantic Core invariants.",
  "properties": {
    "authority": {"$ref": "userspace-lock-discovery-v1.schema.json#/$defs/authority"},
    "channel": {"const": "reviewed"},
    "files": {
      "items": {"$ref": "#/$defs/file"},
      "maxItems": 4096,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {"const": "opemos-userspace-lock-generation"},
    "previousManifestSha256": {
      "oneOf": [
        {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        {"type": "null"}
      ]
    },
    "publishedAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "schemaVersion": {"const": 1},
    "sequence": {"maximum": 18446744073709551615, "minimum": 1, "type": "integer"},
    "targetLocks": {
      "items": {"$ref": "userspace-lock-discovery-v1.schema.json#/$defs/targetLock"},
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": ["schemaVersion", "kind", "channel", "sequence", "publishedAt", "authority", "previousManifestSha256", "targetLocks", "files"],
  "title": "OPEMOS reviewed userspace-lock generation manifest v1",
  "type": "object"
}
