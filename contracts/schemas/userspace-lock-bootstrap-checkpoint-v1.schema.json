{
  "$id": "https://corniidog.github.io/OPEMOS/contracts/userspace-lock-bootstrap-checkpoint-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Inactive minimum signed-generation checkpoint bound to one canonical bootstrap-policy payload.",
  "properties": {
    "kind": {"const": "opemos-userspace-lock-bootstrap-checkpoint"},
    "minimumManifestSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "minimumSequence": {"maximum": 18446744073709551615, "minimum": 1, "type": "integer"},
    "policySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schemaVersion": {"const": 1}
  },
  "required": ["schemaVersion", "kind", "policySha256", "minimumSequence", "minimumManifestSha256"],
  "title": "OPEMOS userspace-lock bootstrap checkpoint v1",
  "type": "object"
}
