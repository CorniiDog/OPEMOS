{
  "$id": "https://corniidog.github.io/OPEMOS/contracts/source-intent-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "ref": {"maxLength": 1024, "minLength": 1, "type": "string"},
        "repository": {"maxLength": 255, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string"}
      },
      "required": ["repository", "ref", "commit"],
      "type": "object"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "architecture": {"const": "x86_64"},
        "kernelVersion": {"maxLength": 255, "pattern": "^[A-Za-z0-9._+~-]+$", "type": "string"},
        "steamosVersion": {"pattern": "^[0-9]+(?:\\.[0-9]+){2}$", "type": "string"}
      },
      "required": ["steamosVersion", "kernelVersion", "architecture"],
      "type": "object"
    },
    "version": {"pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$", "type": "string"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "automatic"}}},
      "then": {"properties": {"selection": {"type": "null"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "exact-published-artifact"}}},
      "then": {"properties": {"selection": {"additionalProperties": false, "properties": {"releaseTag": {"maxLength": 1024, "pattern": "^[A-Za-z0-9._+~-]+$", "type": "string"}}, "required": ["releaseTag"], "type": "object"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "exact-target-local-build"}}},
      "then": {"properties": {"selection": {"additionalProperties": false, "properties": {"nvidiaVersion": {"$ref": "#/$defs/version"}}, "required": ["nvidiaVersion"], "type": "object"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "reviewed-project-source"}}},
      "then": {"properties": {"selection": {"additionalProperties": false, "properties": {"nvidiaVersion": {"$ref": "#/$defs/version"}, "source": {"$ref": "#/$defs/source"}}, "required": ["nvidiaVersion", "source"], "type": "object"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "upstream-development"}}},
      "then": {"properties": {"selection": {"additionalProperties": false, "properties": {"developmentAcknowledged": {"type": "boolean"}, "nvidiaVersion": {"$ref": "#/$defs/version"}, "source": {"$ref": "#/$defs/source"}}, "required": ["nvidiaVersion", "source", "developmentAcknowledged"], "type": "object"}}}
    }
  ],
  "description": "Closed user source intent. Intent is input only; Core separately emits an authorization decision.",
  "properties": {
    "kind": {"const": "opemos-source-intent"},
    "mode": {"enum": ["automatic", "exact-published-artifact", "exact-target-local-build", "reviewed-project-source", "upstream-development"]},
    "schemaVersion": {"const": 1},
    "selection": {},
    "target": {"$ref": "#/$defs/target"}
  },
  "required": ["schemaVersion", "kind", "mode", "target", "selection"],
  "title": "OPEMOS source intent v1",
  "type": "object"
}
