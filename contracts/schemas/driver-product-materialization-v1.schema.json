{
  "$id": "https://corniidog.github.io/OPEMOS/contracts/schemas/driver-product-materialization-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity": {
      "additionalProperties": false,
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "repository": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string"}
      },
      "required": ["repository", "commit"],
      "type": "object"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "bytes": {"minimum": 1, "type": "integer"},
        "name": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}$", "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["name", "bytes", "sha256"],
      "type": "object"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "architecture": {"const": "x86_64"},
        "kernelVersion": {"maxLength": 255, "minLength": 1, "type": "string"},
        "nvidiaVersion": {"pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$", "type": "string"},
        "steamosVersion": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"}
      },
      "required": ["steamosVersion", "kernelVersion", "nvidiaVersion", "architecture"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "core": {"$ref": "#/$defs/identity"},
    "outputs": {
      "additionalProperties": false,
      "properties": {
        "archive": {"$ref": "#/$defs/output"},
        "buildInfo": {"$ref": "#/$defs/output"},
        "checksum": {"$ref": "#/$defs/output"},
        "provenance": {"$ref": "#/$defs/output"}
      },
      "required": ["archive", "checksum", "provenance", "buildInfo"],
      "type": "object"
    },
    "release": {
      "additionalProperties": false,
      "properties": {
        "repository": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string"},
        "tag": {"maxLength": 255, "minLength": 1, "type": "string"}
      },
      "required": ["repository", "tag"],
      "type": "object"
    },
    "representation": {
      "const": {
        "conversion": "none-byte-identical",
        "installerContainer": "tar+gzip",
        "modules": "ko.zst",
        "productMember": "payload/nvidia-driver.tar.zst"
      }
    },
    "schemaVersion": {"const": 1},
    "source": {"$ref": "#/$defs/identity"},
    "status": {"const": "materialized"},
    "target": {"$ref": "#/$defs/target"}
  },
  "required": [
    "schemaVersion", "status", "target", "core", "source", "release",
    "representation", "outputs"
  ],
  "title": "OPEMOS compiled-driver installer materialization result",
  "type": "object"
}
